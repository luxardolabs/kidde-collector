# Template for .env.dev.local — real Kidde account creds for the DEV stack (`make dev-up`).
# Copy to .env.dev.local (gitignored) and fill in. The dev stack layers this over the
# bundled-infra config in .env.demo so it points at a REAL Kidde account while still
# writing to the local bundled InfluxDB/Grafana. Without it, use the demo stack (fakes).

# Kidde HomeSafe account — required to reach the real Kidde cloud API
KIDDE_COLLECTOR_KIDDE_USERNAME=you@example.com
KIDDE_COLLECTOR_KIDDE_PASSWORD=your-kidde-password
