# Runtime image build context, as an include list. The builder stage reads pyproject.toml and
# poetry.lock; the production stage COPYs app/, which runs only its Python modules. Everything
# else (site config, env files, editor swap files, caches, runtime output, untracked probes) is
# left out by the first line, so a file nobody listed never reaches the builder.
*
!pyproject.toml
!poetry.lock
!app/**/*.py

# Classes that must never ship even inside a re-included path. They come after the re-includes
# so they match last, at every depth.
**/__pycache__/
**/*.py[cod]
**/.git
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.envrc
**/*credentials.json
**/*.pem
**/*.key
**/id_rsa*
**/id_dsa*
**/id_ecdsa*
**/id_ed25519*
**/output/
