# --- compose wiring (required by compose.yml) --------------------------------
# ENV_FILE points compose at THIS file for the collector's environment. REGISTRY + TAG
# name the image compose runs — never :latest, because a deployable must not roll.
#   .env.dev  -> TAG=local (your `make build-local`) or TAG=dev
#   .env.prod -> TAG=<the released version>, e.g. TAG=2026.09.0
ENV_FILE=.env.dev
REGISTRY=ghcr.io
TAG=2026.09.0
# Where the collector's output dir lives. A host path on a node, a named volume locally.
OUTPUT_VOLUME=/mnt/docker/kidde-collector/output
RESTART_POLICY=always

# kidde-collector environment template. Copy to .env.dev / .env.prod and fill in.
# .env.dev and .env.prod are gitignored; ONLY this template is committed.
TZ=America/Chicago

# InfluxDB — where device metrics are written (the fleet's external InfluxDB in prod)
KIDDE_COLLECTOR_INFLUXDB_URL=http://influxdb.example.com:8086
KIDDE_COLLECTOR_INFLUXDB_ORG=your-org
KIDDE_COLLECTOR_INFLUXDB_BUCKET=kidde
KIDDE_COLLECTOR_INFLUXDB_TOKEN=your-influxdb-token

# Kidde HomeSafe account — the cloud API credentials the collector authenticates with
KIDDE_COLLECTOR_KIDDE_USERNAME=you@example.com
KIDDE_COLLECTOR_KIDDE_PASSWORD=your-kidde-password

# Poll cadence (seconds)
KIDDE_COLLECTOR_FETCH_INTERVAL_SECONDS=60

# HTTP timeouts (seconds)
KIDDE_COLLECTOR_REQUEST_TIMEOUT=10
KIDDE_COLLECTOR_CONNECTION_TIMEOUT=5

# Kidde API base URL — only override to point at the harness emulator (dev/demo/e2e);
# leave unset in prod to use the real cloud.
# KIDDE_COLLECTOR_API_BASE_URL=https://api.homesafe.kidde.com/api/v4

# Also fetch per-location events (off by default)
KIDDE_COLLECTOR_GET_EVENTS=false

# Offline devices: skip environmental measurements for unresponsive devices (lost/offline/
# contact_lost), writing only a liveness point (online + last_seen). Keeps stale readings
# off the trend dashboards. Set false to record frozen last-known readings too.
KIDDE_COLLECTOR_SKIP_OFFLINE_MEASUREMENTS=true

# Raw API-response capture (writes to the gitignored output/ folder)
KIDDE_COLLECTOR_WRITE_API_DATA=false
KIDDE_COLLECTOR_EXPORT_FOLDER=output

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
KIDDE_COLLECTOR_LOG_LEVEL=INFO
