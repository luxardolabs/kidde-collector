# --- compose wiring (required by compose.yml) --------------------------------
# ENV_FILE points compose at THIS file for the collector's environment. REGISTRY + TAG
# name the image compose runs — never :latest, because a deployable must not roll.
#   .env.dev  -> run by hand (`docker compose --env-file .env.dev up -d`): REGISTRY= (empty) +
#                TAG=local for your `make build-local` (a BARE local image, never pushed).
#                In the fleet, `make dev-deploy` / `make dev-pin` run it on the dev host (DEV_HOST
#                in the Makefile): REGISTRY must be the SAME private registry as the Makefile's REGISTRY (Makefile.local),
#                where `:sha-<commit>` builds are pushed, and dev-deploy writes TAG=sha-<commit>
#                here itself. GHCR only carries released versions. Never TAG=dev: :dev is a
#                moving alias, and nothing pins it. A host-path OUTPUT_VOLUME holds the session
#                cookies and the health heartbeat: give each running collector its own.
#   .env.prod -> REGISTRY=ghcr.io (or your private registry) + TAG=<the released version>
ENV_FILE=.env.dev
REGISTRY=ghcr.io
TAG=2026.11.2
# Where the collector's output dir lives. A host path on a node, a named volume locally.
OUTPUT_VOLUME=/mnt/docker/kidde-collector/output
# Container logs: every deployed service logs through compose.yml's shared `x-logging` block,
# json-file capped at 5 files of 10 MB by default. A host whose Docker daemon logs through another
# driver names it here so compose keeps it (the caps still bound its local copy).
# LOG_DRIVER=json-file
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5

# --- the fleet's dev host only (`make dev-deploy`) ---------------------------
# The dev stack runs the collector plus its own InfluxDB and Grafana (the `devhost` profile),
# with no host port: the Grafana is served by its dev name through the dev host's edge. There:
#   COMPOSE_NAME=kidde-collector-dev
#   COMPOSE_PROFILES=devhost
#   OUTPUT_VOLUME=                       (empty: the project's own named volume)
#   KIDDE_COLLECTOR_INFLUXDB_URL=http://kidde_dev_influxdb:8086
#   KIDDE_COLLECTOR_INFLUXDB_ORG / _BUCKET / _TOKEN = INFLUX_ORG / INFLUX_BUCKET / INFLUX_TOKEN below
# Leave COMPOSE_PROFILES unset anywhere else: the collector alone, against YOUR InfluxDB.
# INFLUX_USER=kidde
# INFLUX_PASSWORD=choose-a-password
# INFLUX_ORG=kidde
# INFLUX_BUCKET=kidde
# INFLUX_TOKEN=choose-a-token
# The admin login is fixed when the Grafana volume is first created: the entrypoint sets the
# password of that first user, so a GRAFANA_USER changed later never exists.
# GRAFANA_USER=admin
# Served by name: the dev Grafana refuses to start with an empty password, `admin`, or this
# placeholder (ops/grafana/dev-entrypoint.sh).
# GRAFANA_PASSWORD=choose-a-password

# kidde-collector environment template. Copy to .env.dev / .env.prod and fill in.
# .env.dev and .env.prod are gitignored; ONLY this template is committed.
TZ=America/Chicago

# InfluxDB — where device metrics are written (the fleet's external InfluxDB in prod)
KIDDE_COLLECTOR_INFLUXDB_URL=http://influxdb.example.com:8086
KIDDE_COLLECTOR_INFLUXDB_ORG=your-org
KIDDE_COLLECTOR_INFLUXDB_BUCKET=kidde
KIDDE_COLLECTOR_INFLUXDB_TOKEN=your-influxdb-token

# Kidde HomeSafe account — the cloud API credentials the collector authenticates with
KIDDE_COLLECTOR_KIDDE_USERNAME=you@example.com
KIDDE_COLLECTOR_KIDDE_PASSWORD=your-kidde-password

# Poll cadence (seconds)
KIDDE_COLLECTOR_FETCH_INTERVAL_SECONDS=60

# HTTP timeouts (seconds)
KIDDE_COLLECTOR_REQUEST_TIMEOUT=10
KIDDE_COLLECTOR_CONNECTION_TIMEOUT=5

# Kidde API base URL — only override to point at the harness emulator (dev/demo/e2e);
# leave unset in prod to use the real cloud.
# KIDDE_COLLECTOR_API_BASE_URL=https://api.homesafe.kidde.com/api/v4

# Also fetch per-location events (off by default)
KIDDE_COLLECTOR_GET_EVENTS=false

# Offline devices: skip environmental measurements for unresponsive devices (lost/offline/
# contact_lost), writing only a liveness point (online + last_seen). Keeps stale readings
# off the trend dashboards. Set false to record frozen last-known readings too.
KIDDE_COLLECTOR_SKIP_OFFLINE_MEASUREMENTS=true

# Raw API-response capture (writes to the gitignored output/ folder)
KIDDE_COLLECTOR_WRITE_API_DATA=false
KIDDE_COLLECTOR_EXPORT_FOLDER=output

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
KIDDE_COLLECTOR_LOG_LEVEL=INFO
