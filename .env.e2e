# Hardware-free end-to-end stack — the `e2e` profile of compose.yml. Driven by
# `make test-e2e`. Every value here is a fixed TEST value, not a secret.
#   docker compose --env-file .env.e2e --profile e2e up -d
ENV_FILE=.env.e2e
COMPOSE_NAME=kidde-collector-e2e
REGISTRY=ghcr.io
TAG=local
RESTART_POLICY=on-failure

# Bundled InfluxDB (named volume; `down -v` wipes it every run)
INFLUX_USER=kidde
INFLUX_PASSWORD=kidde-e2e-password
INFLUX_ORG=kidde
INFLUX_BUCKET=kidde
INFLUX_TOKEN=kidde-e2e-token

KIDDE_FAKE_LOCATION_LABEL=E2E Home

# Collector: authenticate against the fake endpoint, write to the bundled InfluxDB
KIDDE_COLLECTOR_KIDDE_USERNAME=e2e@example.com
KIDDE_COLLECTOR_KIDDE_PASSWORD=e2e-password
KIDDE_COLLECTOR_API_BASE_URL=http://kidde_fake:8080/api/v4
KIDDE_COLLECTOR_INFLUXDB_URL=http://kidde_influxdb:8086
KIDDE_COLLECTOR_INFLUXDB_ORG=kidde
KIDDE_COLLECTOR_INFLUXDB_BUCKET=kidde
KIDDE_COLLECTOR_INFLUXDB_TOKEN=kidde-e2e-token
KIDDE_COLLECTOR_FETCH_INTERVAL_SECONDS=10
KIDDE_COLLECTOR_WRITE_API_DATA=false
KIDDE_COLLECTOR_LOG_LEVEL=INFO
