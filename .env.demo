# Self-contained DEV/DEMO stack config (compose.dev.yml / compose.demo.yml). Unlike
# .env.dev/.env.prod these are NOT real secrets — they configure a throwaway, local-only
# InfluxDB + Grafana created fresh on `make dev-up` / `make demo-up`. Safe to commit so
# `docker compose up` works out of the box. Do NOT reuse these values anywhere real.

TZ=America/Chicago

# --- Bundled InfluxDB (demo) ---
INFLUX_ORG=kidde
INFLUX_BUCKET=kidde
INFLUX_TOKEN=kidde-collector-demo-token-not-secret
INFLUX_USER=kidde
INFLUX_PASSWORD=kiddedemo-password

# --- Bundled Grafana (demo) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Published host ports (override if 3000/8086 are taken on your host).
GRAFANA_PORT=3000
INFLUX_PORT=8086

# --- Collector -> bundled InfluxDB (reached by service name on the bridge network) ---
KIDDE_COLLECTOR_INFLUXDB_URL=http://kidde_influxdb:8086
KIDDE_COLLECTOR_INFLUXDB_ORG=kidde
KIDDE_COLLECTOR_INFLUXDB_BUCKET=kidde
KIDDE_COLLECTOR_INFLUXDB_TOKEN=kidde-collector-demo-token-not-secret

# --- Kidde account ---
# DEV stack: overridden by the gitignored .env.dev.local with your REAL account, so
# the collector polls real Kidde data into the bundled InfluxDB.
# DEMO stack: the fake Kidde endpoint accepts any credentials, so these dummy values
# are fine (compose.demo.yml also points KIDDE_COLLECTOR_API_BASE_URL at the emulator).
KIDDE_COLLECTOR_KIDDE_USERNAME=demo@example.com
KIDDE_COLLECTOR_KIDDE_PASSWORD=demo-password

KIDDE_COLLECTOR_WRITE_API_DATA=false
KIDDE_COLLECTOR_EXPORT_FOLDER=output
KIDDE_COLLECTOR_LOG_LEVEL=INFO
